ARG VERSION=dev
ARG GIT_SHA=unknown
ARG AZURELINUX_BASE=mcr.microsoft.com/azurelinux/base/core:3.0@sha256:1c56f09437dfc2910faad39abaaed336265d246cf183e2adb362d4cb3b881ab6
ARG GO_BUILD_IMAGE=go-toolchain

# Keep the default image visible to Dependabot while retaining the build override.
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26.8-1@sha256:dcdfc27fb8224a64128b5f82026acbf1d63458cfa9a34fa4b60c07574ff52332 AS go-toolchain

# ── Install Node.js 24 from official tarball ───────────────────
# Keep the LTS line accepted by OpenClaw's dependencies.
# Qualify openclaw doctor when changing this pin; earlier Node 24 builds hung.
FROM ${AZURELINUX_BASE} AS node-install
ARG NODE_VERSION=24.19.0
ARG NODE_SHA256_X64=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
ARG NODE_SHA256_ARM64=01443c1e1a29e531ccad5a46fefa6df490d2189c49f7955904aecdbb0fe86fdc
RUN tdnf install -y ca-certificates curl tar xz libgcc-atomic && tdnf clean all
RUN UNAME_M=$(uname -m) && \
    if [ "$UNAME_M" = "x86_64" ]; then NODE_ARCH="x64"; NODE_SHA256="${NODE_SHA256_X64}"; \
    elif [ "$UNAME_M" = "aarch64" ]; then NODE_ARCH="arm64"; NODE_SHA256="${NODE_SHA256_ARM64}"; \
    else echo "Unsupported architecture: $UNAME_M" >&2; exit 1; fi && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -o /tmp/node.tar.xz && \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check && \
    tar xf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz

# ── Build Go tools from source with the pinned fixed Go toolchain ────────────────
# Upstream release binaries can lag Go stdlib CVE fixes, so build the tools here.
FROM ${GO_BUILD_IMAGE} AS tailscale-build
ARG TAILSCALE_VERSION=1.100.0
ARG TAILSCALE_SRC_SHA256=d9e097d82f08c8557c887ca71962b20f08e27f3b305902ea504bd0e472486b97
RUN curl -fsSL "https://github.com/tailscale/tailscale/archive/v${TAILSCALE_VERSION}.tar.gz" -o /tmp/tailscale.tar.gz && \
    echo "${TAILSCALE_SRC_SHA256}  /tmp/tailscale.tar.gz" | sha256sum --check && \
    tar xzf /tmp/tailscale.tar.gz -C /tmp && \
    mv /tmp/tailscale-${TAILSCALE_VERSION} /src && \
    rm /tmp/tailscale.tar.gz
WORKDIR /src
RUN GOFLAGS="-trimpath" CGO_ENABLED=0 GOEXPERIMENT=ms_nocgo_opensslcrypto \
    go build -o /out/tailscale ./cmd/tailscale && \
    GOFLAGS="-trimpath" CGO_ENABLED=0 GOEXPERIMENT=ms_nocgo_opensslcrypto \
    go build -o /out/tailscaled ./cmd/tailscaled

# -- Build GitHub CLI from source with the pinned Go toolchain --
FROM ${GO_BUILD_IMAGE} AS gh-build
ARG GH_VERSION=2.95.0
ARG GH_SRC_SHA256=b6a1c88cbd15f49f60a68d210a117a60b349bcb0d028a0dca0ef2d9dc92bd028
RUN curl -fsSL "https://github.com/cli/cli/archive/refs/tags/v${GH_VERSION}.tar.gz" -o /tmp/gh.tar.gz && \
    echo "${GH_SRC_SHA256}  /tmp/gh.tar.gz" | sha256sum --check && \
    tar xzf /tmp/gh.tar.gz -C /tmp && \
    mv /tmp/cli-${GH_VERSION} /src && \
    rm /tmp/gh.tar.gz
WORKDIR /src
RUN GOFLAGS="-trimpath" CGO_ENABLED=0 GOEXPERIMENT=ms_nocgo_opensslcrypto \
    go build \
      -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=${GH_VERSION} -X github.com/cli/cli/v2/internal/build.Date=2026-06-17" \
      -o /out/gh ./cmd/gh

# -- Build kubectl from source with the pinned Go toolchain --
FROM ${GO_BUILD_IMAGE} AS kubectl-build
ARG KUBECTL_VERSION=1.36.4
ARG KUBERNETES_SRC_SHA256=86a216801ddba7098a50c6f3b3fe5fbc28ba34ea5b1daa66d81c2d5307c301ac
ARG KUBERNETES_GIT_COMMIT=bb826b1d48562f110659e64e8ec444327433db95
RUN curl -fsSL "https://github.com/kubernetes/kubernetes/archive/refs/tags/v${KUBECTL_VERSION}.tar.gz" -o /tmp/kubernetes.tar.gz && \
    echo "${KUBERNETES_SRC_SHA256}  /tmp/kubernetes.tar.gz" | sha256sum --check && \
    tar xzf /tmp/kubernetes.tar.gz -C /tmp && \
    mv /tmp/kubernetes-${KUBECTL_VERSION} /src && \
    rm /tmp/kubernetes.tar.gz
WORKDIR /src
RUN GOFLAGS="-trimpath" CGO_ENABLED=0 GOEXPERIMENT=ms_nocgo_opensslcrypto \
    go build \
      -ldflags "-s -w -X k8s.io/component-base/version.gitMajor=1 -X k8s.io/component-base/version.gitMinor=36 -X k8s.io/component-base/version.gitVersion=v${KUBECTL_VERSION} -X k8s.io/component-base/version.gitCommit=${KUBERNETES_GIT_COMMIT} -X k8s.io/component-base/version.gitTreeState=clean" \
      -o /out/kubectl ./cmd/kubectl

# ── Main image ──────────────────────────────────────────────────
FROM ${AZURELINUX_BASE}
ARG VERSION
ARG GIT_SHA

LABEL org.opencontainers.image.source="https://github.com/Azure/CetiRun"
LABEL org.opencontainers.image.description="CetiRun shared agent base image"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.licenses="MIT"

ARG TZ=UTC
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV TZ="$TZ"

# Install Node.js from the build stage; libgcc-atomic provides libatomic.so.1.
# Copy entire /usr/local prefix to preserve npm/npx symlinks
COPY --from=node-install /usr/local/ /usr/local/

# Install system packages (ordered alphabetically for readability)
RUN tdnf install -y \
  bind-utils \
  ca-certificates \
  curl \
  diffutils \
  git \
  gnupg2 \
  iptables \
  iproute \
  jq \
  less \
  libgcc-atomic \
  man-db \
  nano \
  procps-ng \
  python3 \
  python3-pip \
  shadow-utils \
  sudo \
  tar \
  tmux \
  unzip \
  vim \
  wget \
  zsh \
  && tdnf update -y \
  && tdnf clean all

RUN for tool in sh cp mkdir mv rm chmod mktemp find cmp; do \
      command -v "$tool" >/dev/null 2>&1 || exit 1; \
    done

# Fix CVE-2026-12151 when the Node release bundles undici 6.26.0 inside npm.
# npm overrides can't reach npm's internal node_modules, so replace in-place.
RUN UNDICI_DIR=/usr/local/lib/node_modules/npm/node_modules/undici && \
    if [ -d "${UNDICI_DIR}" ]; then \
      cd "${UNDICI_DIR}" && \
      npm pack undici@6.27.0 --quiet --registry "${NPM_REGISTRY}" && \
      tar xzf undici-6.27.0.tgz --strip-components=1 && \
      rm -f undici-6.27.0.tgz && \
      test "$(node -p 'require("./package.json").version')" = "6.27.0"; \
    fi

# Install GitHub CLI and kubectl from fixed-toolchain build stages.
COPY --from=gh-build /out/gh /usr/local/bin/gh
COPY --from=kubectl-build /out/kubectl /usr/local/bin/kubectl

ARG MSGPACK_VERSION=1.2.1
ARG SETUPTOOLS_VERSION=80.10.2
ARG PYPI_INDEX_URL=https://pypi.org/simple/

COPY configs/sync-pip-vendor.py /usr/local/share/cetirun/sync-pip-vendor.py

# Install Azure CLI (available natively in Azure Linux 3.0 repos)
# Both system pip and Azure CLI's bundled pip need their own vendor updates.
RUN tdnf install -y azure-cli && \
    AZ_SITE=$(sed -n 's/.*PYTHONPATH="\([^"]*\)".*/\1/p' /usr/bin/az | head -n 1) && \
    AZ_SITE=$(printf '%s\n' "$AZ_SITE" | sed 's#\$bin_dir#/usr/bin#g') && \
    AZ_SITE=$(realpath "$AZ_SITE") && \
    SYSTEM_PIP_VENDOR=$(python3 -c 'from pathlib import Path; import pip._vendor; print(Path(pip._vendor.__file__).parent.resolve())') && \
    for PIP_VENDOR in "${SYSTEM_PIP_VENDOR}" "${AZ_SITE}/pip/_vendor"; do \
      test -f "${PIP_VENDOR}/vendor.txt" && \
      echo "Updating pip vendor packages in ${PIP_VENDOR}" && \
      python3 -m pip install --no-cache-dir --break-system-packages --root-user-action=ignore \
        --index-url "${PYPI_INDEX_URL}" \
        --upgrade --no-deps --only-binary=:all: --target "${PIP_VENDOR}" \
        "msgpack==${MSGPACK_VERSION}" "setuptools==${SETUPTOOLS_VERSION}" && \
      PYTHONPATH="${PIP_VENDOR%/pip/_vendor}" python3 -c \
        'import sys; from pathlib import Path; from pip._vendor import msgpack, pkg_resources; root = Path(sys.argv[1]).resolve(); assert Path(msgpack.__file__).resolve().parent == root / "msgpack"; assert Path(pkg_resources.__file__).resolve().parent == root / "pkg_resources"; assert msgpack.__version__ == sys.argv[2]; assert msgpack.unpackb(msgpack.packb({"ok": True})) == {"ok": True}; pkg_resources.Requirement.parse("setuptools>=78.1.1")' \
        "${PIP_VENDOR}" "${MSGPACK_VERSION}" && \
      python3 /usr/local/share/cetirun/sync-pip-vendor.py "${PIP_VENDOR}" \
        --msgpack-version "${MSGPACK_VERSION}" --setuptools-version "${SETUPTOOLS_VERSION}" && \
      python3 /usr/local/share/cetirun/sync-pip-vendor.py "${PIP_VENDOR}" \
        --msgpack-version "${MSGPACK_VERSION}" --setuptools-version "${SETUPTOOLS_VERSION}" --check \
      || exit 1; \
    done && \
    tdnf clean all

# Install ripgrep (not in Azure Linux repos — GitHub release binary)
ARG RIPGREP_VERSION=14.1.1
ARG RIPGREP_SHA256=4cf9f2741e6c465ffdb7c26f38056a59e2a2544b51f7cc128ef28337eeae4d8e
RUN curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl.tar.gz" -o /tmp/rg.tar.gz && \
    echo "${RIPGREP_SHA256}  /tmp/rg.tar.gz" | sha256sum --check && \
    tar xzf /tmp/rg.tar.gz -C /tmp && \
    install -m 755 /tmp/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl/rg /usr/local/bin/rg && \
    rm -rf /tmp/rg* /tmp/ripgrep-*


# Install supervisor (not in Azure Linux repos — pure Python)
RUN pip install --no-cache-dir --break-system-packages --index-url "${PYPI_INDEX_URL}" supervisor

# Install ttyd (web terminal) - pinned version with checksum verification
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
RUN curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" -o /usr/local/bin/ttyd && \
    echo "${TTYD_SHA256}  /usr/local/bin/ttyd" | sha256sum --check && \
    chmod +x /usr/local/bin/ttyd

# Install Tailscale (mesh VPN — only activated when TAILSCALE_ENABLED=true)
# Built from source in the tailscale-build stage with the pinned Go toolchain.
COPY --from=tailscale-build /out/tailscale /usr/local/bin/tailscale
COPY --from=tailscale-build /out/tailscaled /usr/local/bin/tailscaled

# Create vibe user
RUN groupadd --gid 1024 vibe && \
  useradd -s /bin/zsh --uid 1024 --gid 1024 -m vibe && \
  echo vibe ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/vibe && \
  chmod 0440 /etc/sudoers.d/vibe

# Ensure default vibe user has access to shared agent install paths.
RUN mkdir -p /usr/local/share/npm-global /usr/local/share/cetirun /usr/local/lib/hermes-agent && \
  chown -R vibe:vibe /usr/local/share /usr/local/lib/hermes-agent

WORKDIR /home/vibe

# Set up non-root user
USER vibe

# Setup NPM Paths
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin:/home/vibe/.local/bin

# Configure zsh with oh-my-zsh (archive download pinned to commit — avoids curl|bash)
ARG OHMYZSH_COMMIT=7c10d9839f05b8b73e26aa4e0f04cc886fbba6a6
RUN curl -fsSL "https://github.com/ohmyzsh/ohmyzsh/archive/${OHMYZSH_COMMIT}.tar.gz" -o /tmp/ohmyzsh.tar.gz && \
    mkdir -p /home/vibe/.oh-my-zsh && \
    tar xzf /tmp/ohmyzsh.tar.gz --strip-components=1 -C /home/vibe/.oh-my-zsh && \
    rm /tmp/ohmyzsh.tar.gz && \
    cp /home/vibe/.oh-my-zsh/templates/zshrc.zsh-template /home/vibe/.zshrc
ENV SHELL=/bin/zsh

# Allow Codex CLI running without sandboxing
ENV CODEX_UNSAFE_ALLOW_NO_SANDBOX=1

COPY --chown=vibe:vibe .npmrc /home/vibe/.npmrc

# Preserve the selected registry in the non-root user's config. `npm ci` also
# rewrites package-lock URLs that point at npmjs, while retaining mirror-owned
# tarball URLs such as those returned by Azure DevOps-backed feeds.
RUN npm config set registry "${NPM_REGISTRY}" && \
    npm config set replace-registry-host npmjs

# npm dependency policy for the shared tool installation root.
# Add narrowly scoped CVE overrides here only when pinned upstreams still need them.
COPY --chown=vibe:vibe configs/cve-overrides.json /usr/local/share/npm-global/lib/package.json

# Install common npm global tools from the shared dependency-policy package root.
# Uses local install (not -g) so npm respects any future overrides.
# Pin Codex to avoid prerelease platform-package resolution changes breaking image builds.
ARG CODEX_VERSION=0.153.0
ARG OPENCODE_VERSION=1.18.33
RUN mkdir -p /usr/local/share/npm-global/bin && \
    cd /usr/local/share/npm-global/lib && \
    npm install @openai/codex@${CODEX_VERSION} opencode-ai@${OPENCODE_VERSION} && \
    for b in node_modules/.bin/*; do \
      [ -L "$b" ] && ln -sf "$(readlink -f "$b")" /usr/local/share/npm-global/bin/$(basename "$b"); \
    done && \
    npm cache clean --force

# npm 11.16+ blocks undeclared lifecycle scripts. OpenCode's reviewed
# postinstall selects and verifies the already-installed target-platform binary.
RUN cd /usr/local/share/npm-global/lib && \
    npm pkg set 'allowScripts.opencode-ai=true' --json && \
    npm rebuild opencode-ai && \
    test "$(opencode --version)" = "${OPENCODE_VERSION}"

# Install uv (pinned version with checksum verification — avoids curl|bash)
ARG UV_VERSION=0.11.13
ARG UV_SHA256=f830ea3d38ae1492acf53cb7f2cd0f81d6ae22b42d2d7310a6c7d42c451e1a43
RUN mkdir -p /home/vibe/.local/bin && \
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" -o /tmp/uv.tar.gz && \
    echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum --check && \
    tar xzf /tmp/uv.tar.gz -C /tmp && \
    install -m 755 /tmp/uv-x86_64-unknown-linux-gnu/uv /home/vibe/.local/bin/uv && \
    install -m 755 /tmp/uv-x86_64-unknown-linux-gnu/uvx /home/vibe/.local/bin/uvx && \
    rm -rf /tmp/uv*

# Install Claude Code into the same local prefix so it shares dependency policy.
ARG CLAUDE_CODE_VERSION=2.1.163
RUN mkdir -p /usr/local/share/npm-global/bin && \
    cd /usr/local/share/npm-global/lib && \
    npm install @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && \
    for b in node_modules/.bin/*; do \
      [ -L "$b" ] && ln -sf "$(readlink -f "$b")" /usr/local/share/npm-global/bin/$(basename "$b"); \
    done && \
    npm cache clean --force && \
    if [ -f ~/.claude.json ]; then \
      jq '. + {"hasCompletedOnboarding": true}' ~/.claude.json > /tmp/claude.json && mv /tmp/claude.json ~/.claude.json; \
    else \
      echo '{"hasCompletedOnboarding": true}' > ~/.claude.json; \
    fi

RUN cd /usr/local/share/npm-global/lib && \
    npm pkg set 'allowScripts[@anthropic-ai/claude-code]=true' --json && \
    npm rebuild @anthropic-ai/claude-code && \
    claude --version | grep -F "${CLAUDE_CODE_VERSION}"

# Create config directories and symlink shared skills for opencode and codex
RUN mkdir -p /home/vibe/.codex /home/vibe/.kube /home/vibe/.config/opencode && \
    ln -s /home/vibe/.aks/skills /home/vibe/.config/opencode/skills && \
    ln -s /home/vibe/.aks/skills /home/vibe/.codex/skills

# Prepare shared-skills plugin for Claude Code.
# When skills.shared is enabled, Azure Blob Storage is mounted at /home/vibe/.aks/skills.
# Claude Code discovers skills via plugins, so we create a local marketplace with a
# symlinked skills/ dir. Dangling symlink is harmless when skills.shared is off.
RUN mkdir -p /home/vibe/.aks-skills/.claude-plugin \
             /home/vibe/.aks-skills/plugins/aks-shared-skills/.claude-plugin && \
    echo '{"$schema":"https://anthropic.com/claude-code/marketplace.schema.json","name":"aks-local","metadata":{"version":"0.1.0","description":"AKS shared skills from Azure Blob Storage","pluginRoot":"./plugins"},"owner":{"name":"CetiRun"},"plugins":[{"name":"aks-shared-skills","description":"AKS shared skills synced from Azure Blob Storage","version":"0.1.0","source":"./plugins/aks-shared-skills","strict":false}]}' \
      > /home/vibe/.aks-skills/.claude-plugin/marketplace.json && \
    echo '{"name":"aks-shared-skills","description":"AKS shared skills from Azure Blob Storage","version":"0.1.0"}' \
      > /home/vibe/.aks-skills/plugins/aks-shared-skills/.claude-plugin/plugin.json && \
    ln -s /home/vibe/.aks/skills /home/vibe/.aks-skills/plugins/aks-shared-skills/skills


# Environments for vibe-kanban
ENV FRONTEND_PORT=8080
ENV HOST=0.0.0.0
EXPOSE 8080


# ttyd web terminal port
EXPOSE 7681

CMD ["/bin/zsh"]
