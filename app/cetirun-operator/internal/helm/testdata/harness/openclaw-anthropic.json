{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            }
          },
          "model": {
            "primary": "anthropic/test-model"
          },
          "modelPolicy": {
            "allow": [
              "anthropic/test-model"
            ]
          },
          "models": {
            "anthropic/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "anthropic:default": {
            "mode": "api_key",
            "provider": "anthropic"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800
          }
        },
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "gateway": {
        "controlUi": {
          "dangerouslyAllowHostHeaderOriginFallback": true
        },
        "mode": "local",
        "port": 18789,
        "trustedProxies": [
          "127.0.0.6"
        ]
      },
      "logging": {
        "level": "info"
      },
      "memory": {
        "search": {
          "enabled": false,
          "rememberAcrossConversations": false
        }
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "models": {
        "providers": {
          "anthropic": {
            "baseUrl": "https://models.example.com/v1",
            "models": [
              {
                "id": "test-model",
                "name": "test-model"
              }
            ]
          }
        }
      },
      "plugins": {
        "allow": [
          "github",
          "acpx"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          },
          "github": {
            "enabled": true
          }
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "513659bda3dcc3a6c0605bbd7b134ee46dfe67403303b04697e4da3e9fad0afe",
