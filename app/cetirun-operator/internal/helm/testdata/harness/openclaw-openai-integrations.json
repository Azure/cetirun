{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true,
        "maxConcurrentSessions": 8,
        "runtime": {
          "ttlMinutes": 120
        },
        "stream": {
          "coalesceIdleMs": 300,
          "maxChunkChars": 1200
        }
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            },
            "reserveTokensFloor": 20000
          },
          "memorySearch": {
            "enabled": false
          },
          "model": {
            "primary": "openai/test-model"
          },
          "models": {
            "openai/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "openai:default": {
            "mode": "api-key",
            "provider": "openai"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "color": "#FF4500",
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800,
            "color": "#FF4500"
          }
        },
        "remoteCdpHandshakeTimeoutMs": 3000,
        "remoteCdpTimeoutMs": 1500,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "channels": {
        "msteams": {
          "dmPolicy": "allowlist",
          "enabled": true,
          "groupPolicy": "allowlist",
          "replyStyle": "thread",
          "webhook": {
            "path": "/api/messages",
            "port": 3978
          }
        },
        "slack": {
          "groupPolicy": "open"
        },
        "telegram": {
          "network": {
            "autoSelectFamily": false
          }
        }
      },
      "gateway": {
        "controlUi": {
          "allowInsecureAuth": true,
          "dangerouslyAllowHostHeaderOriginFallback": true,
          "dangerouslyDisableDeviceAuth": true
        },
        "mode": "local",
        "port": 18789
      },
      "logging": {
        "level": "info"
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "models": {
        "providers": {
          "openai": {
            "baseUrl": "https://models.example.com/v1",
            "models": [
              {
                "id": "test-model",
                "name": "test-model"
              }
            ]
          }
        }
      },
      "plugins": {
        "allow": [
          "acpx",
          "msteams"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          },
          "discord": {
            "enabled": true
          },
          "feishu": {
            "enabled": true
          },
          "msteams": {
            "enabled": true
          },
          "slack": {
            "enabled": true
          },
          "telegram": {
            "enabled": true
          }
        }
      },
      "skills": {
        "load": {
          "extraDirs": [
            "/home/vibe/.aks/skills",
            "/home/vibe/.cetirun/skills/npm/@example__skill",
            "/home/vibe/.cetirun/skills/npm/example-skill"
          ],
          "watch": true,
          "watchDebounceMs": 250
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        },
        "web": {
          "search": {
            "enabled": true,
            "provider": "perplexity"
          }
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "faec4b049f4a24c79bec10b60b2a510f2a473c42de3647a39d0af53ef73ca2fc",
    "deny-exec-policy.yaml": "7dd9900c6cb720cda23eae4abebcdd68e7d868d91be7df00bac133f63acb4267",
    "networkpolicy.yaml": "6e6daab385ee395ace40d6677ebc9ba26d9a5df8da62b8cf447fcd15818c1644",
    "pre-upgrade-hook.yaml": "06438617ca6f50d2ea5d2e0e898f95cad13438e19e07b141c52a7b19725f60fc",
    "service.yaml": "dcfd18b807bd496a41124356859059a9db89b86d5fde460591bbd4275d4aca22",
    "shared-skills-pv.yaml": "38c08b871f0dfe5237fff4c92fd6622e54c9b81edec9bcb10c79f68075035e77",
    "shared-skills-pvc.yaml": "d5af7044cd33fb9d6ddacb1d23aa2fbcc17d0ddcbfa42f9e10f2a7103ab75d7d",
    "statefulset.yaml": "299f7d4e1f02b79c2187cbb89418239978865a3792d87783d1eeb1c09068f27d"
  }
}
