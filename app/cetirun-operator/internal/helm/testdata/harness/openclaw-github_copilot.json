{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true,
        "maxConcurrentSessions": 8,
        "runtime": {
          "ttlMinutes": 120
        },
        "stream": {
          "coalesceIdleMs": 300,
          "maxChunkChars": 1200
        }
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            },
            "reserveTokensFloor": 20000
          },
          "memorySearch": {
            "enabled": false
          },
          "model": {
            "fallbacks": [],
            "primary": "github-copilot/test-model"
          },
          "models": {
            "github-copilot/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "github-copilot:github": {
            "mode": "token",
            "provider": "github-copilot"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "color": "#FF4500",
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800,
            "color": "#FF4500"
          }
        },
        "remoteCdpHandshakeTimeoutMs": 3000,
        "remoteCdpTimeoutMs": 1500,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "channels": {
        "telegram": {
          "network": {
            "autoSelectFamily": false
          }
        }
      },
      "gateway": {
        "controlUi": {
          "dangerouslyAllowHostHeaderOriginFallback": true,
          "dangerouslyDisableDeviceAuth": true
        },
        "mode": "local",
        "port": 18789
      },
      "logging": {
        "level": "info"
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "plugins": {
        "allow": [
          "acpx"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          }
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "53ce2ed21fdbe3886ad3f4f0f72e3b45b7450229d747ef990a266ee1125b585b",
    "deny-exec-policy.yaml": "7dd9900c6cb720cda23eae4abebcdd68e7d868d91be7df00bac133f63acb4267",
    "networkpolicy.yaml": "3f5bd08e96470dcf976b98106eb0679b3a293e893ffeb17cf9ea1740e11ad53b",
    "pre-upgrade-hook.yaml": "06438617ca6f50d2ea5d2e0e898f95cad13438e19e07b141c52a7b19725f60fc",
    "service.yaml": "0e521e16c134f8dc5cf3cf8b117a6b5f456705a2cd214e1d2a46bdbc9dbf391c",
    "statefulset.yaml": "4ec1845c9c46f2f38a89be30d8f9d8612836fe74b325a79db057b983bfee2667"
  }
}
