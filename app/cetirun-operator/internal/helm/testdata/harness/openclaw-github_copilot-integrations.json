{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            }
          },
          "model": {
            "fallbacks": [],
            "primary": "github-copilot/test-model"
          },
          "modelPolicy": {
            "allow": [
              "github-copilot/test-model"
            ]
          },
          "models": {
            "github-copilot/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "github-copilot:github": {
            "mode": "token",
            "provider": "github-copilot"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800
          }
        },
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "channels": {
        "msteams": {
          "dmPolicy": "allowlist",
          "enabled": true,
          "groupPolicy": "allowlist",
          "replyStyle": "thread",
          "webhook": {
            "path": "/api/messages",
            "port": 3978
          }
        },
        "slack": {
          "groupPolicy": "open"
        },
        "telegram": {
          "network": {
            "autoSelectFamily": false
          }
        }
      },
      "gateway": {
        "controlUi": {
          "dangerouslyAllowHostHeaderOriginFallback": true
        },
        "mode": "local",
        "port": 18789,
        "trustedProxies": [
          "127.0.0.6",
          "127.0.0.1"
        ]
      },
      "logging": {
        "level": "info"
      },
      "memory": {
        "search": {
          "enabled": false,
          "rememberAcrossConversations": false
        }
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "plugins": {
        "allow": [
          "github",
          "brave",
          "telegram",
          "slack",
          "discord",
          "feishu",
          "acpx",
          "msteams"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          },
          "brave": {
            "enabled": true
          },
          "discord": {
            "enabled": true
          },
          "feishu": {
            "enabled": true
          },
          "github": {
            "enabled": true
          },
          "msteams": {
            "enabled": true
          },
          "slack": {
            "enabled": true
          },
          "telegram": {
            "enabled": true
          }
        }
      },
      "skills": {
        "load": {
          "extraDirs": [
            "/home/vibe/.aks/skills",
            "/home/vibe/.cetirun/skills/npm/@example__skill",
            "/home/vibe/.cetirun/skills/npm/example-skill"
          ],
          "watch": true
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        },
        "web": {
          "search": {
            "enabled": true,
            "provider": "brave"
          }
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "03151b2b0939da140481757144b9ff3fe1451883daf8dbcf84fb3606bb14d2b6",
    "deny-exec-policy.yaml": "d85249c97b870e0dbb0882e2d6edf7bce5f111747a17317526d57a27ef70912c",
    "networkpolicy.yaml": "e71831723d761652ee6f625d7d36e0764a584cf813d2b39638c8cfd1b9b9504a",
    "pre-upgrade-hook.yaml": "06438617ca6f50d2ea5d2e0e898f95cad13438e19e07b141c52a7b19725f60fc",
    "service.yaml": "baa7d022acf61be11565fd8dc8c9ecd36a6a5e2a677c6f41d59353d13bce45ba",
    "shared-skills-pv.yaml": "38c08b871f0dfe5237fff4c92fd6622e54c9b81edec9bcb10c79f68075035e77",
    "shared-skills-pvc.yaml": "d5af7044cd33fb9d6ddacb1d23aa2fbcc17d0ddcbfa42f9e10f2a7103ab75d7d",
    "statefulset.yaml": "84c0753307c68d87e28f59332fd647638aeb4f80eae4f8454ebb30c70a574e50"
  }
}
