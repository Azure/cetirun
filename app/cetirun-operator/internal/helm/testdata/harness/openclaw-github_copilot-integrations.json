{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            }
          },
          "model": {
            "fallbacks": [],
            "primary": "github-copilot/test-model"
          },
          "modelPolicy": {
            "allow": [
              "github-copilot/test-model"
            ]
          },
          "models": {
            "github-copilot/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "github-copilot:github": {
            "mode": "token",
            "provider": "github-copilot"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800
          }
        },
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "channels": {
        "msteams": {
          "dmPolicy": "allowlist",
          "enabled": true,
          "groupPolicy": "allowlist",
          "replyStyle": "thread",
          "webhook": {
            "path": "/api/messages",
            "port": 3978
          }
        },
        "slack": {
          "groupPolicy": "open"
        },
        "telegram": {
          "network": {
            "autoSelectFamily": false
          }
        }
      },
      "gateway": {
        "controlUi": {
          "dangerouslyAllowHostHeaderOriginFallback": true
        },
        "mode": "local",
        "port": 18789,
        "trustedProxies": [
          "127.0.0.6",
          "127.0.0.1"
        ]
      },
      "logging": {
        "level": "info"
      },
      "memory": {
        "search": {
          "enabled": false,
          "rememberAcrossConversations": false
        }
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "plugins": {
        "allow": [
          "github",
          "brave",
          "telegram",
          "slack",
          "discord",
          "feishu",
          "acpx",
          "msteams"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          },
          "brave": {
            "enabled": true
          },
          "discord": {
            "enabled": true
          },
          "feishu": {
            "enabled": true
          },
          "github": {
            "enabled": true
          },
          "msteams": {
            "enabled": true
          },
          "slack": {
            "enabled": true
          },
          "telegram": {
            "enabled": true
          }
        }
      },
      "skills": {
        "load": {
          "extraDirs": [
            "/home/vibe/.aks/skills",
            "/home/vibe/.cetirun/skills/npm/@example__skill",
            "/home/vibe/.cetirun/skills/npm/example-skill"
          ],
          "watch": true
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        },
        "web": {
          "search": {
            "enabled": true,
            "provider": "brave"
          }
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "07dba6df6eedf8e392791b43aa547679a52736bfe0864d65f77e6b9947113130",
    "deny-exec-policy.yaml": "7dd9900c6cb720cda23eae4abebcdd68e7d868d91be7df00bac133f63acb4267",
    "networkpolicy.yaml": "6e6daab385ee395ace40d6677ebc9ba26d9a5df8da62b8cf447fcd15818c1644",
    "pre-upgrade-hook.yaml": "06438617ca6f50d2ea5d2e0e898f95cad13438e19e07b141c52a7b19725f60fc",
    "service.yaml": "dcfd18b807bd496a41124356859059a9db89b86d5fde460591bbd4275d4aca22",
    "shared-skills-pv.yaml": "38c08b871f0dfe5237fff4c92fd6622e54c9b81edec9bcb10c79f68075035e77",
    "shared-skills-pvc.yaml": "d5af7044cd33fb9d6ddacb1d23aa2fbcc17d0ddcbfa42f9e10f2a7103ab75d7d",
    "statefulset.yaml": "b5512211cfc41eb968f824a092b19d2c32d39b0637c2d2b9b2904ef40d4282a6"
  }
}
