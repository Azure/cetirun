{
  "native": {
    "openclaw.json": {
      "acp": {
        "allowedAgents": [
          "claude",
          "codex",
          "opencode"
        ],
        "backend": "acpx",
        "defaultAgent": "claude",
        "dispatch": {
          "enabled": true
        },
        "enabled": true,
        "maxConcurrentSessions": 8,
        "runtime": {
          "ttlMinutes": 120
        },
        "stream": {
          "coalesceIdleMs": 300,
          "maxChunkChars": 1200
        }
      },
      "agents": {
        "defaults": {
          "compaction": {
            "memoryFlush": {
              "enabled": true,
              "softThresholdTokens": 4000
            },
            "reserveTokensFloor": 20000
          },
          "memorySearch": {
            "enabled": false
          },
          "model": {
            "primary": "openai/test-model"
          },
          "models": {
            "openai/test-model": {}
          },
          "verboseDefault": "on"
        }
      },
      "auth": {
        "profiles": {
          "openai:default": {
            "mode": "api-key",
            "provider": "openai"
          }
        }
      },
      "browser": {
        "attachOnly": true,
        "color": "#FF4500",
        "defaultProfile": "openclaw",
        "enabled": true,
        "headless": false,
        "noSandbox": true,
        "profiles": {
          "openclaw": {
            "cdpPort": 18800,
            "color": "#FF4500"
          }
        },
        "remoteCdpHandshakeTimeoutMs": 3000,
        "remoteCdpTimeoutMs": 1500,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": true
        }
      },
      "channels": {
        "telegram": {
          "network": {
            "autoSelectFamily": false
          }
        }
      },
      "gateway": {
        "controlUi": {
          "dangerouslyAllowHostHeaderOriginFallback": true,
          "dangerouslyDisableDeviceAuth": true
        },
        "mode": "local",
        "port": 18789
      },
      "logging": {
        "level": "info"
      },
      "meta": {
        "lastTouchedVersion": "0.1.0"
      },
      "models": {
        "providers": {
          "openai": {
            "baseUrl": "https://models.example.com/v1",
            "models": [
              {
                "id": "test-model",
                "name": "test-model"
              }
            ]
          }
        }
      },
      "plugins": {
        "allow": [
          "acpx"
        ],
        "entries": {
          "acpx": {
            "config": {
              "nonInteractivePermissions": "deny",
              "permissionMode": "approve-all"
            },
            "enabled": true
          }
        }
      },
      "tools": {
        "profile": "full",
        "sessions": {
          "visibility": "all"
        }
      },
      "update": {
        "checkOnStart": false
      }
    }
  },
  "manifestHashes": {
    "configmap.yaml": "920d4c5e689645cd4a017897f7dc3987485f135f2966c7ec5cef04fedec102fd",
    "deny-exec-policy.yaml": "7dd9900c6cb720cda23eae4abebcdd68e7d868d91be7df00bac133f63acb4267",
    "networkpolicy.yaml": "3f5bd08e96470dcf976b98106eb0679b3a293e893ffeb17cf9ea1740e11ad53b",
    "pre-upgrade-hook.yaml": "06438617ca6f50d2ea5d2e0e898f95cad13438e19e07b141c52a7b19725f60fc",
    "service.yaml": "0e521e16c134f8dc5cf3cf8b117a6b5f456705a2cd214e1d2a46bdbc9dbf391c",
    "statefulset.yaml": "e537c1f15fe878be34a5c4b12c673e81d8c4e60e14c370bfe85ebed847b753e6"
  }
}
