{
  "name": "cetirun-portal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "licenses": "node scripts/production-licenses.mjs",
    "licenses:check-updates": "node scripts/update-license-supplements.mjs",
    "test:licenses": "node --test scripts/test-production-licenses.mjs scripts/test-update-license-supplements.mjs",
    "test": "npm run test:licenses && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.341",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.2.5",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "tabster": "8.7.0"
  }
}
