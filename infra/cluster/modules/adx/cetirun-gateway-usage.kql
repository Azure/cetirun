//
// Daily AI Gateway usage, kept longer than the request log: a materialized
// view of the Gateway table in the CetiRun logs database. It has one row per
// day, cluster, Agent UID and name, AI Gateway user and owner alias, Team,
// model, provider model and provider, GitHub Copilot route, and call origin.
// Kusto keeps it up to date as rows arrive. __RETENTION_DAYS__ is its retention
// in days; the ADX module of the cluster template replaces it and runs this
// script after cetirun-logs.kql, which creates the Gateway table. The view
// counts a row that ADX-Mon delivers twice twice, as GatewayRequests() does.
//
// GatewayDailyUsageV2 replaces GatewayDailyUsage of earlier templates. That
// view has only the Agent's name and the owner's alias, which other Agents and
// users can also have, and Kusto cannot change how a view groups its rows.
// Where an earlier template created it, it stays and keeps its rows; this
// script does not create or change it.
//
// The view counts the rows that arrive after its creation. Kusto refuses to
// fill a new view with the earlier rows (backfill) while some of them are
// outside the hot cache, which is the case for a Gateway table older than the
// hot cache period; the script would then fail at every deployment.
.create ifnotexists materialized-view with (folder = "CetiRun", docString = "Daily AI Gateway calls, tokens and spend per cluster, Agent UID and name, AI Gateway user and owner alias, Team, model, provider model, provider, GitHub Copilot route and call origin, from the creation of the view. CallOrigin is health_check for LiteLLM's own probes.") GatewayDailyUsageV2 on table Gateway {
    Gateway
    | where Container == "gateway" and tostring(Body['log_type']) == "cetirun.ai_gateway.request"
    | extend Metadata = Body['key_metadata']
    | summarize
        Calls = count(),
        FailedCalls = countif(tostring(Body['status']) == "failure"),
        PromptTokens = sum(tolong(Body['prompt_tokens'])),
        CompletionTokens = sum(tolong(Body['completion_tokens'])),
        CachedTokens = sum(tolong(Body['cached_tokens'])),
        CacheCreationTokens = sum(tolong(Body['cache_creation_tokens'])),
        ReasoningTokens = sum(tolong(Body['reasoning_tokens'])),
        Spend = sum(toreal(Body['spend']))
        by Day = bin(Timestamp, 1d), Cluster,
        AgentUid = tostring(Metadata['cetirun_agent_uid']),
        Agent = tostring(Metadata['cetirun_agent']),
        // The AI Gateway user of the key: the owner's Entra tenant and
        // object IDs (tenant/object), or agent:<UID> for an Agent without
        // them. Before CetiRun v0.2.0, the owner's alias.
        UserId = tostring(Body['user_id']),
        Owner = tostring(Metadata['cetirun_user']),
        Team = tostring(Metadata['cetirun_team']),
        Model = tostring(Body['model']),
        ProviderModel = tostring(Body['provider_model']),
        Provider = tostring(Body['provider']),
        // The operator registers the GitHub Copilot routes of an Agent's
        // owner with deployment IDs that start with this prefix. These
        // calls use the owner's Copilot subscription.
        CopilotRoute = tostring(Body['deployment_id']) startswith "cetirun-copilot-",
        CallOrigin = tostring(Body['call_origin'])
}

.alter materialized-view GatewayDailyUsageV2 policy retention '{"SoftDeletePeriod": "__RETENTION_DAYS__.00:00:00", "Recoverability": "Enabled"}'

.alter materialized-view GatewayDailyUsageV2 policy caching hot = 31d
