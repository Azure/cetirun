//
// Table, ingestion mapping and query functions of the CetiRun content
// database: the prompts and responses of AI Gateway calls. Its readers are a
// separate, small group. The AI Gateway writes one row per part of a call's
// request or response (cetirun_ai_gateway/content.py), as JSON lines with the
// mapping ContentMapping.
.create-merge table Content (Timestamp: datetime, Cluster: string, Body: dynamic)

.create-or-alter table Content ingestion json mapping "ContentMapping" '[{"column":"Timestamp","path":"$.time","datatype":"datetime"},{"column":"Cluster","path":"$.cluster","datatype":"string"},{"column":"Body","path":"$","datatype":"dynamic"}]'

.create-or-alter function with (folder = "CetiRun", docstring = "The calls in rows of the Content table, with their request and response text, the parts of each joined again. Filter the rows first: the Gateway looks up one call this way.", skipvalidation = "true") GatewayContentOf(T: (Timestamp: datetime, Cluster: string, Body: dynamic)) {
    T
    | project
        Timestamp,
        Cluster,
        CallId = tostring(Body['call_id']),
        RequestId = tostring(Body['request_id']),
        Model = tostring(Body['model']),
        Status = tostring(Body['status']),
        Agent = tostring(Body['agent']),
        AgentUid = tostring(Body['agent_uid']),
        Owner = tostring(Body['owner']),
        Team = tostring(Body['team']),
        LiteLLMUserId = tostring(Body['litellm_user_id']),
        LiteLLMTeamId = tostring(Body['litellm_team_id']),
        Kind = tostring(Body['kind']),
        Part = toint(Body['part']),
        Parts = toint(Body['parts']),
        Text = tostring(Body['text'])
    | summarize Timestamp = min(Timestamp), Received = count(), Pieces = make_list(bag_pack("p", Part, "t", Text)),
        Parts = max(Parts) by Cluster, CallId, RequestId, Model, Status, Agent, AgentUid, Owner, Team, LiteLLMUserId, LiteLLMTeamId, Kind
    | mv-apply Piece = Pieces on (
        order by toint(Piece['p']) asc
        | summarize Text = strcat_array(make_list(tostring(Piece['t'])), "")
    )
    | extend Complete = Received == Parts
    | project-away Pieces
}

.create-or-alter function with (folder = "CetiRun", docstring = "AI Gateway calls with their request and response text, the parts of each joined again. Join with GatewayRequests() of the logs database on CallId.", skipvalidation = "true") GatewayContent() {
    GatewayContentOf(Content)
}
