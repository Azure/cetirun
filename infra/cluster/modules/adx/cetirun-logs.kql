//
// Query functions of the CetiRun logs database. The ADX module of the
// cluster template runs this script; for another Kusto cluster, run it as
// .execute database script <| (this file without the comment lines).
// skipvalidation lets the functions exist before the first rows create their
// tables.
.create-or-alter function with (folder = "CetiRun", docstring = "AI Gateway calls, one row per call, from the Gateway request log. No request or response content.", skipvalidation = "true") GatewayRequests() {
    Gateway
    | where Container == "gateway" and tostring(Body['log_type']) == "cetirun.ai_gateway.request"
    | extend Metadata = Body['key_metadata']
    | project
        Timestamp = todatetime(Body['time']),
        StartTime = todatetime(Body['start_time']),
        Cluster,
        Pod,
        Status = tostring(Body['status']),
        Route = tostring(Body['route']),
        CallType = tostring(Body['call_type']),
        // A call LiteLLM makes itself: health_check for its background probes,
        // or a router's classifier call. Empty for a client's call.
        CallOrigin = tostring(Body['call_origin']),
        RoutingTier = tostring(Body['routing_tier']),
        RoutingCause = tostring(Body['routing_cause']),
        RoutingScore = toreal(Body['routing_score']),
        // An escalation keyword or the length of the prompt moved the call
        // one tier up.
        RoutingEscalated = tobool(Body['routing_escalated']),
        ClassifierModel = tostring(Body['classifier_model']),
        ClassifierCost = toreal(Body['classifier_cost']),
        // A call LiteLLM made after an attempt of the request failed: the model
        // the request was for, and the class of the first failure.
        FallbackFrom = tostring(Body['fallback_from']),
        AttemptedFallbacks = tolong(Body['attempted_fallbacks']),
        FallbackCause = tostring(Body['fallback_cause']),
        Stream = tobool(Body['stream']),
        Model = tostring(Body['model']),
        ProviderModel = tostring(Body['provider_model']),
        Provider = tostring(Body['provider']),
        DeploymentId = tostring(Body['deployment_id']),
        ApiBase = tostring(Body['api_base']),
        DurationMs = toreal(Body['duration_ms']),
        TimeToFirstTokenMs = toreal(Body['time_to_first_token_ms']),
        PromptTokens = tolong(Body['prompt_tokens']),
        CompletionTokens = tolong(Body['completion_tokens']),
        TotalTokens = tolong(Body['total_tokens']),
        CachedTokens = tolong(Body['cached_tokens']),
        CacheCreationTokens = tolong(Body['cache_creation_tokens']),
        ReasoningTokens = tolong(Body['reasoning_tokens']),
        Spend = toreal(Body['spend']),
        ResponseCacheHit = tobool(Body['response_cache_hit']),
        Agent = tostring(Metadata['cetirun_agent']),
        AgentUid = tostring(Metadata['cetirun_agent_uid']),
        Owner = tostring(Metadata['cetirun_user']),
        Team = tostring(Metadata['cetirun_team']),
        KeyAlias = tostring(Body['key_alias']),
        KeyHash = tostring(Body['key_hash']),
        UserId = tostring(Body['user_id']),
        TeamId = tostring(Body['team_id']),
        EndUser = tostring(Body['end_user']),
        ClientIp = tostring(Body['client_ip']),
        UserAgent = tostring(Body['user_agent']),
        RequestTags = Body['request_tags'],
        RequestId = tostring(Body['request_id']),
        CallId = tostring(Body['call_id']),
        TraceId = tostring(Body['trace_id']),
        ErrorClass = tostring(Body['error_class']),
        ErrorCode = tostring(Body['error_code']),
        ErrorProvider = tostring(Body['error_provider']),
        ErrorMessage = tostring(Body['error_message']),
        RateLimitType = tostring(Body['rate_limit_type']),
        BudgetEntityType = tostring(Body['budget_entity_type']),
        Truncated = tobool(Body['truncated'])
}

.create-or-alter function with (folder = "CetiRun", docstring = "Kubernetes events from the telemetry program, one row per event version.", skipvalidation = "true") KubeEvents() {
    Telemetry
    | where Container == "telemetry" and tostring(Body['log_type']) == "cetirun.k8s.event"
    | extend Event = Body['event']
    | project
        Timestamp = todatetime(Event['last_time']),
        Cluster,
        Type = tostring(Event['type']),
        Reason = tostring(Event['reason']),
        Message = tostring(Event['message']),
        ObjectKind = tostring(Event['object']['kind']),
        ObjectNamespace = tostring(Event['object']['namespace']),
        ObjectName = tostring(Event['object']['name']),
        ObjectUid = tostring(Event['object']['uid']),
        Count = tolong(Event["count"]),
        FirstTime = todatetime(Event['first_time']),
        Source = tostring(Event['source']),
        EventNamespace = tostring(Event['namespace']),
        EventName = tostring(Event['name']),
        EventUid = tostring(Event['uid']),
        ResourceVersion = tostring(Event['resource_version']),
        RecordTime = todatetime(Body['time'])
    | summarize arg_max(RecordTime, *) by Cluster, EventUid, ResourceVersion
}

.create-or-alter function with (folder = "CetiRun", docstring = "Every inventory record of the Agents: which namespace, owner, Team and policy an Agent had, and when.", skipvalidation = "true") AgentInventoryHistory() {
    Telemetry
    | where Container == "telemetry" and tostring(Body['log_type']) == "cetirun.inventory.agent"
    | extend Agent = Body['agent']
    | project
        RecordTime = todatetime(Body['time']),
        Cluster,
        Action = tostring(Body['action']),
        SnapshotId = tostring(Body['snapshot_id']),
        AgentName = tostring(Agent['name']),
        AgentUid = tostring(Agent['uid']),
        AgentNamespace = tostring(Agent['namespace']),
        AgentType = tostring(Agent['type']),
        Owner = tostring(Agent['owner']['alias']),
        OwnerDisplayName = tostring(Agent['owner']['display_name']),
        OwnerEmail = tostring(Agent['owner']['email']),
        OwnerTenantId = tostring(Agent['owner']['tenant_id']),
        OwnerObjectId = tostring(Agent['owner']['object_id']),
        Team = tostring(Agent['team']),
        Policy = tostring(Agent['policy']),
        Sandbox = tostring(Agent['sandbox']),
        Phase = tostring(Agent['phase']),
        Suspended = tobool(Agent['suspended']),
        Deleting = tobool(Agent['deleting']),
        Created = todatetime(Agent['created'])
}

.create-or-alter function with (folder = "CetiRun", docstring = "Complete inventory snapshots: one row per cluster, kind and snapshot, written once every object of the kind was written with the snapshot's ID.", skipvalidation = "true") InventorySnapshots() {
    Telemetry
    | where Container == "telemetry" and tostring(Body['log_type']) == "cetirun.inventory.snapshot"
    | extend Snapshot = Body['snapshot']
    | project
        RecordTime = todatetime(Body['time']),
        Cluster,
        SnapshotId = tostring(Snapshot['id']),
        Kind = tostring(Snapshot['kind']),
        Started = todatetime(Snapshot['started']),
        Objects = tolong(Snapshot['objects'])
}

.create-or-alter function with (folder = "CetiRun", docstring = "The current Agents, with their latest record: those of the latest complete snapshot of each cluster whose entries have all arrived, and those created or changed after it started. An Agent with a delete record is never current.", skipvalidation = "true") AgentInventory() {
    let history = AgentInventoryHistory();
    // Kubernetes never reuses a UID: an Agent with a delete record is gone,
    // also when a snapshot entry comes after the delete.
    let deleted = history | where Action == "delete" | distinct Cluster, AgentUid;
    // The collector uploads batches concurrently, so a completion record can
    // arrive before some entries of its snapshot. A snapshot counts once all
    // of them have arrived; until then, the previous one does.
    let received = history
        | where Action == "snapshot" and isnotempty(SnapshotId)
        | summarize Received = count_distinct(AgentUid) by Cluster, SnapshotId;
    let lastSnapshot = InventorySnapshots()
        | where Kind == "cetirun.inventory.agent"
        | join kind=leftouter received on Cluster, SnapshotId
        | where coalesce(Received, long(0)) == Objects
        | summarize arg_max(Started, SnapshotId) by Cluster
        | project Cluster, LatestSnapshot = SnapshotId, Started;
    // A cluster with a complete snapshot: the Agents it saw, and the Agents
    // created or changed after it started. An Agent deleted while the
    // telemetry program was not running is in neither.
    let reconciled = history
        | join kind=inner lastSnapshot on Cluster
        | where SnapshotId == LatestSnapshot or (Action == "upsert" and RecordTime >= Started)
        | project-away Cluster1, LatestSnapshot, Started;
    // A cluster without one, from a telemetry program that marks no
    // snapshots: the latest record of each Agent.
    let unreconciled = history | join kind=leftanti lastSnapshot on Cluster;
    union reconciled, unreconciled
    | summarize arg_max(RecordTime, *) by Cluster, AgentUid
    | join kind=leftanti deleted on Cluster, AgentUid
}
