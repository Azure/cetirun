// Identify egress traffic blocked by the blacklist EnvoyFilter (RBAC DENY)
// Blocked connections are reset at TCP level: response_code=0, bytes_sent=0
// The RBAC filter rejects before data flows, so there's no HTTP response code

ContainerLogV2
| where PodNamespace startswith "cetirun-"
| where ContainerName == "istio-proxy"
| where LogMessage startswith "{"
| extend Log = parse_json(LogMessage)
| where tostring(Log.upstream_cluster) !startswith "inbound"
| where toint(Log.response_code) == 0 and toint(Log.bytes_sent) == 0
| extend
    Destination = coalesce(tostring(Log.requested_server_name), tostring(Log.upstream_host)),
    ResponseFlags = tostring(Log.response_flags)
| where isnotempty(Destination)
| summarize
    BlockedCount = count(),
    FirstBlocked = min(TimeGenerated),
    LastBlocked = max(TimeGenerated)
    by Destination, PodNamespace
| order by BlockedCount desc
